# Gemini API key (server-side only — never ships to the RN app)
GEMINI_API_KEY=your_gemini_api_key_here

# Which Gemini Live model to use
GEMINI_LIVE_MODEL=models/gemini-2.0-flash-live-001

# Port the proxy listens on
PORT=8080

# Testing-stage only: a shared secret your own client sends as the "idToken" to
# authenticate. Replace with real Google Sign-In verification once you have users.
PROXY_TEST_SECRET=pick_any_long_random_string

# RevenueCat webhook Authorization header secret
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret_here

# Paddle: notification destination secret (prefixed pdl_ntfset_), used to verify
# the Paddle-Signature header on POST /paddle-webhook
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here

# Paddle: API key used server-side to look up a customer's email from
# customer_id (transaction.completed webhooks don't include the email inline)
PADDLE_API_KEY=your_paddle_api_key_here

# Paddle API base URL — use https://sandbox-api.paddle.com while testing
PADDLE_API_BASE_URL=https://api.paddle.com
